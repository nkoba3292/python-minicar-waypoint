{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "IMU Debug - PC Mock Mode",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/imu_debug_simple.py",
            "console": "integratedTerminal",
            "env": {
                "MOCK_SENSORS": "True",
                "DEBUG_MODE": "True"
            },
            "args": []
        },
        {
            "name": "IMU Debug - Ultimate (PC)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/imu_debug_ultimate.py",
            "console": "integratedTerminal",
            "env": {
                "MOCK_SENSORS": "True",
                "DEBUG_MODE": "True"
            },
            "args": []
        },
        {
            "name": "Main Control Loop - PC Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main_control_loop.py",
            "console": "integratedTerminal",
            "env": {
                "MOCK_SENSORS": "True",
                "DEBUG_MODE": "True",
                "SIMULATION_MODE": "True"
            },
            "args": []
        },
        {
            "name": "Debug Workflow - Setup",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_workflow.py",
            "console": "integratedTerminal",
            "args": ["--mode", "setup"]
        },
        {
            "name": "Debug Workflow - Deploy",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/debug_workflow.py",
            "console": "integratedTerminal",
            "args": ["--mode", "deploy", "--raspberry-ip", "192.168.1.100"]
        }
    ]
}