{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Development Environment",
            "type": "shell",
            "command": "python",
            "args": ["debug_workflow.py", "--mode", "setup"],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy to Raspberry Pi",
            "type": "shell",
            "command": "python",
            "args": [
                "debug_workflow.py", 
                "--mode", "deploy", 
                "--raspberry-ip", "${input:raspberryIP}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Remote Debug Session",
            "type": "shell",
            "command": "python",
            "args": [
                "debug_workflow.py", 
                "--mode", "remote", 
                "--raspberry-ip", "${input:raspberryIP}"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "Sync Logs from Raspberry Pi",
            "type": "shell",
            "command": "python",
            "args": [
                "debug_workflow.py", 
                "--mode", "sync", 
                "--raspberry-ip", "${input:raspberryIP}"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "Monitor Raspberry Pi",
            "type": "shell",
            "command": "python",
            "args": [
                "debug_workflow.py", 
                "--mode", "monitor", 
                "--raspberry-ip", "${input:raspberryIP}"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Run IMU Debug (PC Mock)",
            "type": "shell",
            "command": "python",
            "args": ["imu_debug_simple.py"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "env": {
                "MOCK_SENSORS": "True",
                "DEBUG_MODE": "True"
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "raspberryIP",
            "description": "Raspberry Pi IP Address",
            "default": "192.168.1.100",
            "type": "promptString"
        }
    ]
}